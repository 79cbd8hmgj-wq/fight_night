	<!-- haymaker right hook -->
	<!-- center, right, down, up -->	
	
	<analogCombo>
		<time	value="3.0"/>
		<button1 value="BUT_L"/>
		<button2 value="BUT_R"/>
		<combo>	
			<action			value="start_hook_r"/>		
