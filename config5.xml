<!-- Fight Night PSP Controller Configuration -->
<!-- this is a sample comment -->
<!-- 
	Time is represented in fractions of the game rate in seconds
	0.1 = 1/10th of a second
-->

<!-- Notes / special cases -->
<!-- when applying analog to the lean action, you need to set the analog_type to left -->
<!-- when applying block / lean to a button it must be of the buttonEmulateAnalog type -->

<!-- same as config 4 but with camera-relative boxer movement -->

<config name="config5">
	<!-- analog supported lean w/ shift modifier -->		
	<analog>
	<action value="lean"/>
	<analog_type value="left"/>
	<button1 value="BUT_L"/>
	</analog>
	
	<!-- illegal punch -->
	<tap>
	<time	value="0.3"/>
	<action value="illegal"/>
	<button1 value="D_LEFT"/>	
	</tap>
	
	<!-- taunt -->
	<tap>
	<time	value="0.3"/>
	<action value="taunt"/>
	<button1 value="D_UP"/>	
	</tap>
	
	<!-- grab / clinch -->
	<tap>
	<time	value="0.3"/>
	<action value="grab"/>
	<button1 value="D_RIGHT"/>	
	</tap>
	
	<!-- signature -->
	<tap>
	<time	value="0.3"/>
	<action value="signature"/>
	<button1 value="D_DOWN"/>	
	</tap>
	
	<!-- analog-based blocking -->
	<analog>
	<action value="block"/>
	<analog_type value="right"/>
	<button1 value="BUT_R"/>
	</analog>
	
<!-- analog-based punching -->
	<!-- analog combo -->
	<!-- actions spawned by multiple analog movement in distinct directions -->
	
	<!-- left straight -->
	
	<analogCombo>		
		<time	value="3.0"/>
		<combo>	
			<action			value="punch_l"/>		
			<start_x		value="128"/>
			<start_y		value="128"/>
			<start_range	value="30"/>
			<end_x			value="36"/>
			<end_y			value="255"/>
			<end_range		value="35"/>
		</combo>				
	</analogCombo>
	
	<!-- right straight -->
	<analogCombo>		
		<time	value="3.0"/>
		<combo>	
			<action			value="punch_r"/>		
			<start_x		value="128"/>
			<start_y		value="128"/>
			<start_range	value="30"/>
			<end_x			value="255"/>
			<end_y			value="255"/>
			<end_range		value="35"/>
		</combo>				
	</analogCombo>
	
	<!-- left hook -->
	<analogCombo>		
		<time	value="3.0"/>
		<combo>			
			<action			value="hook_l"/>
			<start_x		value="128"/>
			<start_y		value="128"/>
			<start_range	value="30"/>
			<end_x			value="0"/>
			<end_y			value="128"/>
			<end_range		value="30"/>
		</combo>				
	</analogCombo>
	
	<!-- right hook -->
	<analogCombo>		
		<time	value="3.0"/>
		<combo>	
			<action			value="hook_r"/>		
			<start_x		value="128"/>
			<start_y		value="128"/>
			<start_range	value="30"/>
			<end_x			value="255"/>
			<end_y			value="128"/>
			<end_range		value="30"/>
		</combo>				
	</analogCombo>
	
	<!-- right uppercut -->
	<analogCombo>		
		<time	value="3.0"/>
		<combo>	
			<action			value="uppercut_l"/>		
			<start_x		value="128"/>
			<start_y		value="128"/>
			<start_range	value="30"/>
			<end_x			value="255"/>
			<end_y			value="0"/>
			<end_range		value="30"/>
		</combo>				
	</analogCombo>
	
	<!-- left uppercut -->
	<analogCombo>		
		<time	value="3.0"/>
		<combo>	
			<action			value="uppercut_r"/>		
			<start_x		value="128"/>
			<start_y		value="128"/>
			<start_range	value="30"/>
			<end_x			value="0"/>
			<end_y			value="0"/>
			<end_range		value="30"/>
		</combo>				
	</analogCombo>
		
<!-- button-based movement -->	
	<!-- backward x = min, y = mid -->
	<buttonEmulateAnalog>
		<time	value="0.01"/>
		<action	value="backward"/>
		<button1 value="BUT_X"/>
		<analog_type value="left"/>
		<analog_x value="0"/>
		<analog_y value="128"/>
	</buttonEmulateAnalog>
	
	<!-- forward x = max, y = mid -->
	<buttonEmulateAnalog>
		<time	value="0.01"/>
		<action	value="forward"/>
		<button1 value="BUT_TRI"/>		
		<analog_type value="left"/>
		<analog_x value="255"/>
		<analog_y value="128"/>
	</buttonEmulateAnalog>
	
	<!-- left/up x = mid, y = max -->
	<buttonEmulateAnalog>
		<time	value="0.01"/>
		<action	value="left"/>
		<button1 value="BUT_SQR"/>		
		<analog_type value="left"/>
		<analog_x value="128"/>
		<analog_y value="255"/>
	</buttonEmulateAnalog>
	
	<!-- right/down x = mid, y = min -->
	<buttonEmulateAnalog>
		<time	value="0.01"/>
		<action	value="right"/>
		<button1 value="BUT_CIR"/>		
		<analog_type value="left"/>
		<analog_x value="128"/>
		<analog_y value="0"/>
	</buttonEmulateAnalog>
	
	<!-- haymaker right hook -->	
	<!-- center, right, up (right side) -->
	<analogCombo>		
		<time	value="3.0"/>
		<combo>
			<action			value="start_hook_r"/>		
			<start_x		value="128"/>
			<start_y		value="128"/>
			<start_range	value="30"/>
			<end_x			value="250"/>
			<end_y			value="128"/>
			<end_range		value="35"/>
		</combo>
		
		<combo>
			<action			value="hook_r"/>		
			<start_x		value="250"/>
			<start_y		value="128"/>
			<start_range	value="35"/>
			<end_x			value="250"/>
			<end_y			value="250"/>
			<end_range		value="35"/>
		</combo>		
	</analogCombo>
	
	<!-- haymaker left hook -->	
	<!-- center, left, up (left side) -->
	<analogCombo>		
		<time	value="3.0"/>
		<combo>
			<action			value="start_hook_l"/>		
			<start_x		value="128"/>
			<start_y		value="128"/>
			<start_range	value="30"/>
			<end_x			value="0"/>
			<end_y			value="128"/>
			<end_range		value="35"/>
		</combo>
		
		<combo>
			<action			value="hook_l"/>		
			<start_x		value="0"/>
			<start_y		value="128"/>
			<start_range	value="35"/>
			<end_x			value="0"/>
			<end_y			value="255"/>
			<end_range		value="45"/>
		</combo>		
	</analogCombo>
	
	<!-- haymaker left uppercut -->	
	<!-- center, left bottom, up (left side) -->
	<analogCombo>		
		<time	value="3.0"/>
		<combo>
			<action			value="start_uppercut_l"/>
			<start_x		value="128"/>
			<start_y		value="128"/>
			<start_range	value="30"/>
			<end_x			value="0"/>
			<end_y			value="0"/>
			<end_range		value="40"/>
		</combo>
		
		<combo>
			<action			value="uppercut_l"/>
			<start_x		value="0"/>
			<start_y		value="0"/>
			<start_range	value="40"/>
			<end_x			value="0"/>
			<end_y			value="255"/>
			<end_range		value="45"/>
		</combo>		
	</analogCombo>
	
	<!-- haymaker right uppercut -->	
	<!-- center, right bottom, up (right side) -->
	<analogCombo>		
		<time	value="3.0"/>
		<combo>
			<action			value="start_uppercut_r"/>
			<start_x		value="128"/>
			<start_y		value="128"/>
			<start_range	value="30"/>
			<end_x			value="255"/>
			<end_y			value="0"/>
			<end_range		value="40"/>
		</combo>
		
		<combo>
			<action			value="uppercut_r"/>
			<start_x		value="255"/>
			<start_y		value="0"/>
			<start_range	value="40"/>
			<end_x			value="255"/>
			<end_y			value="255"/>
			<end_range		value="40"/>
		</combo>		
	</analogCombo>

</config>

<!-- end config -->