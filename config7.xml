<!-- Fight Night PSP Controller Configuration -->
<!-- this is a sample comment -->
<!-- 
	Time is represented in fractions of the game rate in seconds
	0.1 = 1/10th of a second
-->

<!-- Notes / special cases -->
<!-- when applying analog to the lean action, you need to set the analog_type to left -->
<!-- when applying block / lean to a button it must be of the buttonEmulateAnalog type -->

<config name="config7">
	<!-- analog supported lean w/ shift modifier -->
	<analog>
	<action value="lean"/>
	<analog_type value="left"/>
	<button1 value="BUT_L"/>
	</analog>
	
	<!-- illegal punch -->
	<tap>
	<time	value="0.3"/>
	<action value="illegal"/>
	<button1 value="D_LEFT"/>	
	</tap>
	
	<!-- taunt -->
	<tap>
	<time	value="0.3"/>
	<action value="taunt"/>
	<button1 value="D_UP"/>	
	</tap>
	
	<!-- grab / clinch -->
	<tap>
	<time	value="0.3"/>
	<action value="grab"/>
	<button1 value="D_RIGHT"/>	
	</tap>
	
	<!-- signature -->
	<tap>
	<time	value="0.3"/>
	<action value="signature"/>
	<button1 value="D_DOWN"/>	
	</tap>

	<!-- button-based blocking -->
	
	<!-- block high x = mid, y = max -->
	<buttonEmulateAnalog>
		<time	value="0.01"/>
		<action	value="block"/>
		<button1 value="BUT_SQR"/>
		<!-- blocks must use this type -->
		<analog_type value="right"/>
		<analog_x value="128"/>
		<analog_y value="255"/>
	</buttonEmulateAnalog>
	
	<!-- block low x = mid, y = min -->
	<buttonEmulateAnalog>
		<time	value="0.01"/>
		<action	value="block"/>		
		<button1 value="BUT_X"/>		
		<!-- blocks must use this type -->
		<analog_type value="right"/>
		<analog_x value="128"/>
		<analog_y value="0"/>
	</buttonEmulateAnalog>
	
	<!-- todo change this to random parry -->
	<!-- parry high right x = max, y = max -->
	<buttonEmulateAnalog>
		<time	value="0.01"/>
		<action	value="block"/>
		<button1 value="BUT_SQR"/>		
		<!-- blocks must use this type -->
		<analog_type value="right"/>
		<analog_x value="255"/>
		<analog_y value="255"/>
	</buttonEmulateAnalog>
	
	<!-- parry high left x = min, y = max -->
	<buttonEmulateAnalog>
		<time	value="0.01"/>
		<action	value="block"/>
		<button1 value="BUT_SQR"/>		
		<!-- blocks must use this type -->
		<analog_type value="right"/>
		<analog_x value="0"/>
		<analog_y value="128"/>
	</buttonEmulateAnalog>
	
	<!-- parry low right x = max, y = min -->
	<buttonEmulateAnalog>
		<time	value="0.01"/>
		<action	value="block"/>
		<button1 value="BUT_SQR"/>		
		<!-- blocks must use this type -->
		<analog_type value="right"/>
		<analog_x value="255"/>
		<analog_y value="0"/>
	</buttonEmulateAnalog>
	
	<!-- parry low left x = min, y = min -->
	<buttonEmulateAnalog>
		<time	value="0.01"/>
		<action	value="block"/>
		<button1 value="BUT_SQR"/>		
		<!-- blocks must use this type -->
		<analog_type value="right"/>
		<analog_x value="0"/>
		<analog_y value="0"/>
	</buttonEmulateAnalog>

	<!-- button-based punches -->
		
	<!-- random punch -->
	<tap>
		<time	value="0.3"/>
		<action value="random_punch_high"/>
		<button1 value="BUT_TRI"/>
	</tap>
	
	<tap>
		<time	value="0.3"/>
		<action value="random_punch_low"/>
		<button1 value="BUT_CIR"/>
	</tap>
	
	<holdrelease>
		<time	value="0.3"/>
		<action value="random_haymaker_high"/>
		<action2 value="random_haymaker_high"/>
		<button1 value="BUT_TRI"/>
	</holdrelease>
	
	<holdrelease>
		<time	value="0.3"/>
		<action value="random_haymaker_low"/>
		<action2 value="random_haymaker_low"/>
		<button1 value="BUT_CIR"/>
	</holdrelease>
	
	<!-- analog movement -->	
	<analog>
	<action value="movement"/>
	<analog_type value="left"/>
	</analog>
</config>

<!-- end config -->